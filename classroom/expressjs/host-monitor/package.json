{
  "type": "module",
  "bin": {
    "host-monitor-mcp": "dist/src/mcp/server.js"
  },
  "scripts": {
    "build": "rm -rf dist && npm run db:generate && tsc && tsc-alias",
    "prisma:generate": "npm run db:generate",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp": "node dist/src/mcp/server.js",
    "test": "npm run typecheck && npm run test:api && npm run test:front",
    "test:api": "RUST_LOG=debug NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=host_monitor_test npm run db:drop && NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=host_monitor_test npm run db:seed && NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=host_monitor_test node --import tsx --test test/api/*.test.ts",
    "test:front": "vitest run test/frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "rm -rf src/generated && npx prisma generate",
    "db:migrate": "POSTGRES_HOST=localhost npx prisma migrate dev",
    "db:seed": "POSTGRES_HOST=localhost npx prisma db seed",
    "db:load": "npm run db:migrate && npm run db:seed",
    "db:drop": "POSTGRES_HOST=localhost npx prisma migrate reset --force",
    "db:reload": "npm run db:drop && npm run db:seed",
    "db:studio": "POSTGRES_HOST=localhost npx prisma studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cuid": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "prisma": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.20",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
