{
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "npm run test:api && npm run test:front",
    "test:api": "NODE_ENV=test npm run db:reload && NODE_ENV=test node --test test/api/*.test.js",
    "test:front": "vitest run test/frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reload": "npm run db:drop && npm run db:load",
    "db:load": "node src/database/load.js",
    "db:drop": "node src/database/database.js drop"
  },
  "dependencies": {
    "cuid": "^3.0.0",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
